{
  "title": "PostPix",
  "type": "object",
  "properties": {
    "transaction_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "pix_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "password": {
      "type": "string",
      "pattern": "^\\d{6}$"
    }
  },
  "required": [
    "transaction_key",
    "pix_key",
    "amount",
    "password"
  ],
  "additionalProperties": false
}
