{
  "title": "PostClient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "monthly_income": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "required": [
    "name",
    "email",
    "document_number",
    "birthdate",
    "monthly_income"
  ],
  "additionalProperties": false
}
