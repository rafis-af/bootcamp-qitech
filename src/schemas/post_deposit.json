{
  "title": "PostDeposit",
  "type": "object",
  "properties": {
    "transaction_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "ted"
      ]
    },
    "depositor_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "depositor_document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "source_bank_code": {
      "type": "string",
      "pattern": "^\\d{3}$"
    }
  },
  "required": [
    "transaction_key",
    "amount",
    "method",
    "depositor_name",
    "depositor_document_number"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "method": {
        "const": "ted"
      }
    },
    "required": [
      "method"
    ]
  },
  "then": {
    "required": [
      "source_bank_code"
    ]
  },
  "else": {
    "properties": {
      "source_bank_code": false
    }
  }
}
