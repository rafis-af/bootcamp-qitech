{
  "title": "GetClients",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(100|[1-9][0-9]?)$"
    },
    "page": {
      "type": "string",
      "pattern": "^[0-9]{1,9}$"
    },
    "status": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "active",
          "blocked"
        ]
      }
    },
    "level": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "silver",
          "gold"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "email": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    }
  },
  "additionalProperties": false
}
